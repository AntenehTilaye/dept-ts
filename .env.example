# Copy to .env (gitignored). Everything not listed here is set by compose.yaml.
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
# Single timezone for cron schedules, reminders and date rendering.
APP_TIMEZONE=Africa/Addis_Ababa
PG_POOL_MAX=10
WORKER_CONCURRENCY=4
PDF_CONCURRENCY=2
UPLOAD_MAX_MB=25
# Used for in-container git commits (docker compose run --rm web git commit ...)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
