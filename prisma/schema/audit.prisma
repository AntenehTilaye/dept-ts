// Audit & domain events (design part 04 §16). AuditEvent and the receipts are append-only;
// DomainEvent is the transactional outbox whose delivery columns the worker may update.

/// Field-level audit trail written by the Prisma interceptor and explicit `record()` calls.
/// NULL departmentId = faculty-level action (admin pages, bypass). SHARED, append-only.
model AuditEvent {
  id               String      @id @default(cuid())
  departmentId     String?     @map("department_id")
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  actorUserId      String?     @map("actor_user_id")
  action           AuditAction
  subjectType      SubjectType @map("subject_type")
  subjectId        String      @map("subject_id")
  fieldChangesJson Json?       @map("field_changes_json")
  reason           String?
  at               DateTime    @default(now())
  correlationId    String?     @map("correlation_id")
  clientInfoJson   Json?       @map("client_info_json")

  @@index([subjectType, subjectId, at])
  @@index([actorUserId, at])
  @@index([departmentId, at])
  @@map("audit_event")
}

/// Transactional outbox: written in the same transaction as the change, drained by the worker
/// (`outbox.dispatch`); `deadAt` after 10 failed attempts. SHARED.
model DomainEvent {
  id            String      @id @default(cuid())
  departmentId  String?     @map("department_id")
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  name          String
  aggregateType SubjectType @map("aggregate_type")
  aggregateId   String      @map("aggregate_id")
  payloadJson   Json        @map("payload_json")
  occurredAt    DateTime    @default(now()) @map("occurred_at")
  publishedAt   DateTime?   @map("published_at")
  deadAt        DateTime?   @map("dead_at")
  attempts      Int         @default(0)
  lastError     String?     @map("last_error")
  correlationId String?     @map("correlation_id")

  receipts EventHandlerReceipt[]

  @@index([publishedAt, id])
  @@index([aggregateType, aggregateId])
  @@index([departmentId])
  @@map("domain_event")
}

/// One receipt per (event, handler): a handler never runs twice for the same event. GLOBAL, append-only.
model EventHandlerReceipt {
  eventId    String      @map("event_id")
  event      DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  handlerKey String      @map("handler_key")
  handledAt  DateTime    @default(now()) @map("handled_at")
  error      String?

  @@id([eventId, handlerKey])
  @@map("event_handler_receipt")
}
