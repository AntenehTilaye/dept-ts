// Identity & Access.
// Tenancy classes (see prisma/rls-manifest.json, generated by prisma/scripts/gen-rls.ts):
//   GLOBAL          no departmentId, no RLS               Department, Permission, SystemSetting
//   SHARED-OR-TENANT nullable departmentId (NULL = faculty-wide row written only under bypass)
//                                                          Role, RolePermission
//   TENANT          required departmentId, FORCE RLS       RoleGrant

/// Organisational unit and tenancy anchor. `id` equals the better-auth Organization id once
/// authentication lands (no default: departments are created through departmentService).
model Department {
  id             String       @id
  organizationId String       @unique @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String       @unique
  name           String
  facultyName    String?      @map("faculty_name")
  headPersonId   String?      @map("head_person_id")
  timezone       String       @default("Africa/Addis_Ababa")
  settingsJson   Json         @default("{}") @map("settings_json")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Back-relations from every tenant-scoped model (gen-rls --check verifies each departmentId
  // field has one). Later phases append to this list.
  roles                  Role[]
  rolePermissions        RolePermission[]
  roleGrants             RoleGrant[]
  persons                DepartmentPerson[]
  staffProfiles          StaffProfile[]
  profileItems           ProfileItem[]
  students               Student[]
  programs               Program[]
  sections               Section[]
  sectionMemberships     StudentSectionMembership[]
  representatives        SectionRepresentative[]
  groups                 Group[]
  groupMemberships       GroupMembership[]
  academicYears          AcademicYear[]
  terms                  Term[]
  calendarPeriods        CalendarPeriod[]
  courses                Course[]
  courseOfferings        CourseOffering[]
  sectionOfferings       SectionOffering[]
  teachingAssignments    TeachingAssignment[]
  enrollments            Enrollment[]
  timetableSlots         ClassTimetableSlot[]
  resources              Resource[]
  workflowDefinitions    WorkflowDefinition[]
  workflowInstances      WorkflowInstance[]
  transitionLogs         WorkflowTransitionLog[]
  auditEvents            AuditEvent[]
  domainEvents           DomainEvent[]
  reminderSchedules      ReminderSchedule[]
  reminderSubscriptions  ReminderSubscription[]
  scheduledJobs          ScheduledJob[]
  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  templates              Template[]
  documents              Document[]
  documentVersions       DocumentVersion[]
  documentLinks          DocumentLink[]
  documentAccessGrants   DocumentAccessGrant[]
  threads                Thread[]
  comments               Comment[]
  tasks                  Task[]
  taskAssignments        TaskAssignment[]
  recurrenceRules        RecurrenceRule[]
  cases                  Case[]
  formDefinitions        FormDefinition[]
  submissions            Submission[]
  answers                Answer[]
  campaigns              Campaign[]
  campaignSubjects       CampaignSubject[]
  campaignInvitations    CampaignInvitation[]
  aggregationResults     AggregationResult[]
  featureDefinitions     FeatureDefinition[]
  featureRecords         FeatureRecord[]
  featureStepInstances   FeatureStepInstance[]
  featureNumberSequences FeatureNumberSequence[]
  featureMigrations      FeatureMigration[]
  availabilityPolicies   AvailabilityPolicy[]
  availabilityBlocks     AvailabilityBlock[]
  importBatches          ImportBatch[]
  importRows             ImportRow[]
  mappingProfiles        ColumnMappingProfile[]

  @@map("department")
}

/// Permission keys "<module>.<action>" (or "feature.<key>.<action>" for compiled features). GLOBAL.
model Permission {
  key         String  @id
  module      String
  action      String
  description String
  isSystem    Boolean @default(true) @map("is_system")
  featureKey  String? @map("feature_key")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permission")
}

/// Role definitions. NULL departmentId = faculty-wide seed; a department row with the same key
/// overrides it. `role_key_global` (partial unique index, migration constraints_p1) keeps global
/// keys unique because NULLs are distinct in the composite unique.
model Role {
  id           String      @id @default(cuid())
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  key          String
  name         String
  description  String?
  isSystem     Boolean     @default(false) @map("is_system")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  permissions RolePermission[]
  grants      RoleGrant[]

  @@unique([departmentId, key])
  @@index([departmentId])
  @@map("role")
}

/// The configurable permission matrix (section 30 of the requirements). NULL departmentId =
/// faculty default; a department row with the same role and permission overrides it.
model RolePermission {
  id            String          @id @default(cuid())
  departmentId  String?         @map("department_id")
  department    Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  roleId        String          @map("role_id")
  role          Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String          @map("permission_key")
  permission    Permission      @relation(fields: [permissionKey], references: [key])
  level         PermissionLevel

  @@unique([departmentId, roleId, permissionKey])
  @@index([departmentId])
  @@index([permissionKey])
  @@map("role_permission")
}

/// A role held by a user, optionally scoped (committee, section, ...) and time-bounded.
/// `source = derived` rows are synchronised from registry facts (membership, committee chair,
/// teaching assignment, representative, lab duty) by outbox handlers and repaired nightly;
/// `manual` rows are edited by administrators. Empty-string defaults keep the identity index
/// free of NULLs. TENANT.
model RoleGrant {
  id              String       @id @default(cuid())
  departmentId    String       @map("department_id")
  department      Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId          String       @map("role_id")
  role            Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeType       ScopeType    @map("scope_type")
  scopeId         String       @default("") @map("scope_id")
  validFrom       DateTime     @default(now()) @map("valid_from")
  validTo         DateTime?    @map("valid_to")
  source          GrantSource
  derivedFromType SubjectType? @map("derived_from_type")
  derivedFromId   String       @default("") @map("derived_from_id")
  grantedBy       String?      @map("granted_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([userId, roleId, scopeType, scopeId, derivedFromId], map: "role_grant_identity")
  @@index([departmentId, userId, validTo])
  @@index([userId, departmentId, validTo])
  @@index([scopeType, scopeId])
  @@index([derivedFromType, derivedFromId])
  @@map("role_grant")
}

/// Typed configuration by scope. GLOBAL: filtered in the app; only admins and the worker
/// heartbeat write.
model SystemSetting {
  key       String
  scope     SettingScope
  scopeId   String       @default("") @map("scope_id")
  valueJson Json         @map("value_json")
  updatedBy String?      @map("updated_by")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@id([key, scope, scopeId])
  @@map("system_setting")
}
