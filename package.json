{
  "name": "deptts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check": "prisma validate && npm run schema:check && next typegen && tsc --noEmit && eslint . && npm run rls:check",
    "worker:dev": "tsx watch --clear-screen=false apps/worker/src/index.ts",
    "worker:build": "esbuild apps/worker/src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=apps/worker/dist/index.js --external:pg --external:pg-boss --external:playwright --external:nodemailer --external:@prisma/client --external:exceljs-hardened --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "test:unit": "vitest run --project unit --project components",
    "test:integration": "vitest run --project integration",
    "test:worker": "vitest run --project worker",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "rls:gen": "tsx prisma/scripts/gen-rls.ts",
    "rls:check": "tsx prisma/scripts/gen-rls.ts --check",
    "schema:check": "tsx prisma/scripts/check-schema.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "1.3.3",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@tanstack/react-table": "9.2.4",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "exceljs-hardened": "5.0.0",
    "file-type": "22.1.1",
    "jose": "6.2.12",
    "lucide-react": "1.47.0",
    "mustache": "4.2.0",
    "next": "16.3.5",
    "nodemailer": "10.0.10",
    "p-limit": "7.3.2",
    "papaparse": "5.7.0",
    "pg": "8.23.0",
    "pg-boss": "12.33.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@prisma/internals": "7.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/mustache": "4.2.6",
    "@types/node": "22.20.3",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.0",
    "pdf-parse": "2.4.5",
    "postcss": "8.5.28",
    "prettier": "3.9.7",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
